<?xml version="1.0" encoding="utf-8"?>
<!--
  Static hosting config for the built Vite/React SPA on Simply.com (IIS).
  This is a purely static site (no server-side .NET), so we only need a default
  document and correct MIME types. Copied verbatim into dist/ by Vite (public/).
-->
<configuration>
  <system.webServer>
    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>
    <staticContent>
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
      <remove fileExtension=".mjs" />
      <mimeMap fileExtension=".mjs" mimeType="text/javascript" />
    </staticContent>
  </system.webServer>
</configuration>
